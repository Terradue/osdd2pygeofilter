def to_opensearch(
    root: ast.AstType, *, attribute_map: Mapping[str, str] | None = None,
    defaults: Mapping[str, str] | None = None,
) -> str:
    """Convert a pygeofilter AST to a query string without a leading '?'."""
    return OpenSearchEvaluator(attribute_map, defaults).evaluate(root)


def from_cql2_text(
    expression: str, *, attribute_map: Mapping[str, str] | None = None,
    defaults: Mapping[str, str] | None = None,
) -> str:
    """Parse CQL2 text and return a validated OpenSearch query string."""
    return to_opensearch(parse_text(expression), attribute_map=attribute_map, defaults=defaults)


def from_cql2_json(
    expression: str, *, attribute_map: Mapping[str, str] | None = None,
    defaults: Mapping[str, str] | None = None,
) -> str:
    """Parse a serialized CQL2 JSON expression into an OpenSearch query string."""
    return to_opensearch(parse_json(expression), attribute_map=attribute_map, defaults=defaults)


def build_url(parameters: Mapping[str, str] | None = None) -> str:
    """Build the invocation URL from decoded HTTP query parameters."""
    return OpenSearchEvaluator().build_url(parameters)
