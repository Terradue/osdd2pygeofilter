_Handler = TypeVar("_Handler", bound="Callable[..., object]")


def _handle(*node_types: type[object]) -> Callable[[_Handler], _Handler]:
    """Register a pygeofilter handler while preserving its callable signature."""

    def register(handler: _Handler) -> _Handler:
        # Upstream handle attaches dispatch metadata in place and returns handler.
        handle(*node_types)(handler)
        return handler

    return register


def _parameters(result: object) -> dict[str, str]:
    """Check the untyped evaluator boundary before exposing query parameters.

    Raises:
        NotImplementedError: If evaluation did not produce string parameters.
    """
    if not isinstance(result, dict):
        raise NotImplementedError("Expected a CQL2 predicate")
    parameters: dict[str, str] = {}
    for key, value in result.items():
        if not isinstance(key, str) or not isinstance(value, str):
            raise NotImplementedError("Expected string query parameters")
        parameters[key] = value
    return parameters


def _is_json_value(value: object) -> TypeGuard[JSONValue]:
    """Check decoded response types without copying potentially large payloads."""
    if value is None or isinstance(value, (str, bool, int, float)):
        return True
    if isinstance(value, list):
        return all(_is_json_value(item) for item in value)
    if isinstance(value, dict):
        return all(isinstance(key, str) and _is_json_value(item) for key, item in value.items())
    return False


def _scalar(value: object) -> str:
    if isinstance(value, bool):
        return "true" if value else "false"
    if isinstance(value, (date, datetime)):
        return value.isoformat()
    if isinstance(value, (str, int, float)):
        return str(value)
    raise NotImplementedError("Expected a scalar literal")


def _assignment(binding: Binding, value: str) -> dict[str, str]:
    """Create a parameter assignment, warning immediately for unlisted values.

    Options are suggestions, so the assigned value remains unchanged. Each
    handler assignment is checked independently, including repeated values.
    """
    options = PARAMETER_OPTIONS.get(binding.query)
    if options and value not in options:
        logging.getLogger(__name__).warning(
            "Parameter %s has value %r outside advertised options %r; "
            "accepting it because options are suggestions",
            binding.query,
            value,
            options,
        )
    return {binding.query: value}


# The upstream base class is untyped; handlers below retain their signatures.
class OpenSearchEvaluator(Evaluator):  # type: ignore[misc]
    """Translate representable CQL2 predicates into decoded query parameters.

    Unsupported operations raise NotImplementedError. Each evaluation is
    independent; no query parameters are retained between calls.
    """

    def __init__(
        self,
        attribute_map: Mapping[str, str] | None = None,
    ) -> None:
        """Configure aliases for CQL2 property names."""
        self.attribute_map = dict(attribute_map or {})

    @_handle(ast.Attribute)
    def attribute(self, node: ast.Attribute) -> Binding:
        """Resolve a CQL2 property to its advertised parameter binding."""
        name = self.attribute_map.get(node.name, node.name)
        for binding in BINDINGS:
            if binding.property == name:
                return binding
        raise ValueError(f"Unknown OpenSearch property: {name}")

    @_handle(str, int, float, bool, date, datetime)
    def literal(self, node: object) -> str:
        """Serialize a scalar without URL encoding it."""
        return _scalar(node)

    @_handle(ast.Equal)
    def equal(self, node: ast.Equal, lhs: object, rhs: object) -> dict[str, str]:
        """Assign a literal to a parameter, including reversed equality."""
        if isinstance(rhs, Binding):
            lhs, rhs = rhs, lhs
        if not isinstance(lhs, Binding) or not isinstance(rhs, str):
            raise NotImplementedError("Equality needs one property and one scalar")
        return _assignment(lhs, rhs)

    @_handle(ast.And)
    def conjunction(
        self,
        node: ast.And,
        lhs: dict[str, str],
        rhs: dict[str, str],
    ) -> dict[str, str]:
        """Combine assignments without discarding conflicting predicates."""
        result = dict(lhs)
        for key, value in rhs.items():
            if key in result and result[key] != value:
                binding = next(binding for binding in BINDINGS if binding.query == key)
                combined = intersect_ranges(binding, result[key], value)
                result.update(_assignment(binding, combined))
            else:
                result[key] = value
        return result

    def _range_binding(self, value: object) -> Binding:
        if not isinstance(value, Binding):
            raise NotImplementedError("A range needs a property")
        if value.namespace != EO or value.local not in EO_INTEGERS | EO_NUMBERS | EO_DATES:
            raise NotImplementedError("Ranges require an EO numeric or date parameter")
        return value

    @_handle(ast.LessThan, ast.LessEqual, ast.GreaterThan, ast.GreaterEqual)
    def comparison(self, node: ast.Comparison, lhs: object, rhs: object) -> dict[str, str]:
        """Translate ordered comparisons into EO open intervals."""
        operator = node.op.value
        if isinstance(rhs, Binding):
            lhs, rhs = rhs, lhs
            operator = {"<": ">", "<=": ">=", ">": "<", ">=": "<="}[operator]
        binding = self._range_binding(lhs)
        value = _scalar(rhs)
        expression = {
            "<": f"{value}[",
            "<=": f"{value}]",
            ">": f"]{value}",
            ">=": f"[{value}",
        }[operator]
        return _assignment(binding, expression)

    @_handle(ast.Between)
    def between(
        self,
        node: ast.Between,
        lhs: object,
        low: object,
        high: object,
    ) -> dict[str, str]:
        """Translate non-negated EO ranges with inclusive bounds."""
        if node.not_:
            raise NotImplementedError("NOT BETWEEN is not representable")
        binding = self._range_binding(lhs)
        return _assignment(binding, f"[{_scalar(low)},{_scalar(high)}]")

    @_handle(ast.In)
    def in_list(self, node: ast.In, lhs: object, *members: object) -> dict[str, str]:
        """Translate non-negated EO numeric/date membership into set syntax."""
        if node.not_:
            raise NotImplementedError("NOT IN is not representable")
        binding = self._range_binding(lhs)
        return _assignment(binding, "{" + ",".join(_scalar(item) for item in members) + "}")

    @_handle(values.Geometry, values.Envelope)
    def geometry(self, node: values.Geometry | values.Envelope) -> str:
        """Serialize the exact geometry as WKT without envelope approximation."""
        return shape(node).wkt

    @_handle(ast.GeometryIntersects)
    def intersects(
        self,
        node: ast.GeometryIntersects,
        lhs: object,
        rhs: object,
    ) -> dict[str, str]:
        """Map intersection to an advertised geo:geometry parameter."""
        if isinstance(rhs, Binding):
            lhs, rhs = rhs, lhs
        if not isinstance(lhs, Binding) or (lhs.namespace, lhs.local) != (GEO, "geometry"):
            raise NotImplementedError("Intersection requires a geo:geometry property")
        result = _assignment(lhs, _scalar(rhs))
        for binding in BINDINGS:
            if (binding.namespace, binding.local) == (GEO, "relation"):
                result.update(_assignment(binding, "intersects"))
        return result


