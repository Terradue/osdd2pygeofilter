def _scalar(value: object) -> str:
    if isinstance(value, bool):
        return "true" if value else "false"
    if isinstance(value, (date, datetime)):
        return value.isoformat()
    if isinstance(value, (str, int, float)):
        return str(value)
    raise NotImplementedError("Expected a scalar literal")


class OpenSearchEvaluator(Evaluator):
    """Translate representable CQL2 predicates into decoded query parameters.

    Unsupported operations raise NotImplementedError. Each evaluation is
    independent; no query parameters are retained between calls.
    """

    def __init__(
        self, attribute_map: Mapping[str, str] | None = None,
    ) -> None:
        """Configure aliases for CQL2 property names."""
        self.attribute_map = dict(attribute_map or {})

    @handle(ast.Attribute)
    def attribute(self, node: ast.Attribute) -> Binding:
        """Resolve a CQL2 property to its advertised parameter binding."""
        name = self.attribute_map.get(node.name, node.name)
        for binding in BINDINGS:
            if binding.property == name:
                return binding
        raise ValueError(f"Unknown OpenSearch property: {name}")

    @handle(str, int, float, bool, date, datetime)
    def literal(self, node: object) -> str:
        """Serialize a scalar without URL encoding it."""
        return _scalar(node)

    @handle(ast.Equal)
    def equal(self, node: ast.Equal, lhs: object, rhs: object) -> dict[str, str]:
        """Assign a literal to a parameter, including reversed equality."""
        if isinstance(rhs, Binding):
            lhs, rhs = rhs, lhs
        if not isinstance(lhs, Binding) or not isinstance(rhs, str):
            raise NotImplementedError("Equality needs one property and one scalar")
        return {lhs.query: rhs}

    @handle(ast.And)
    def conjunction(
        self, node: ast.And, lhs: dict[str, str], rhs: dict[str, str],
    ) -> dict[str, str]:
        """Combine assignments without discarding conflicting predicates."""
        result = dict(lhs)
        for key, value in rhs.items():
            combined = value
            if key in result and result[key] != value:
                binding = next(binding for binding in BINDINGS if binding.query == key)
                combined = intersect_ranges(binding, result[key], value)
            result[key] = combined
        return result

    def _range_binding(self, value: object) -> Binding:
        if not isinstance(value, Binding):
            raise NotImplementedError("A range needs a property")
        if value.namespace != EO or value.local not in EO_INTEGERS | EO_NUMBERS | EO_DATES:
            raise NotImplementedError("Ranges require an EO numeric or date parameter")
        return value

    @handle(ast.LessThan, ast.LessEqual, ast.GreaterThan, ast.GreaterEqual)
    def comparison(self, node: ast.Comparison, lhs: object, rhs: object) -> dict[str, str]:
        """Translate ordered comparisons into EO open intervals."""
        operator = node.op.value
        if isinstance(rhs, Binding):
            lhs, rhs = rhs, lhs
            operator = {"<": ">", "<=": ">=", ">": "<", ">=": "<="}[operator]
        binding = self._range_binding(lhs)
        value = _scalar(rhs)
        expression = {
            "<": f"{value}[", "<=": f"{value}]",
            ">": f"]{value}", ">=": f"[{value}",
        }[operator]
        return {binding.query: expression}

    @handle(ast.Between)
    def between(
        self, node: ast.Between, lhs: object, low: object, high: object,
    ) -> dict[str, str]:
        """Translate non-negated EO ranges with inclusive bounds."""
        if node.not_:
            raise NotImplementedError("NOT BETWEEN is not representable")
        binding = self._range_binding(lhs)
        return {binding.query: f"[{_scalar(low)},{_scalar(high)}]"}

    @handle(ast.In)
    def in_list(self, node: ast.In, lhs: object, *members: object) -> dict[str, str]:
        """Translate non-negated EO numeric/date membership into set syntax."""
        if node.not_:
            raise NotImplementedError("NOT IN is not representable")
        binding = self._range_binding(lhs)
        return {binding.query: "{" + ",".join(_scalar(item) for item in members) + "}"}

    @handle(values.Geometry, values.Envelope)
    def geometry(self, node: values.Geometry | values.Envelope) -> str:
        """Serialize the exact geometry as WKT without envelope approximation."""
        return shape(node).wkt

    @handle(ast.GeometryIntersects)
    def intersects(
        self, node: ast.GeometryIntersects, lhs: object, rhs: object,
    ) -> dict[str, str]:
        """Map intersection to an advertised geo:geometry parameter."""
        if isinstance(rhs, Binding):
            lhs, rhs = rhs, lhs
        if not isinstance(lhs, Binding) or (lhs.namespace, lhs.local) != (GEO, "geometry"):
            raise NotImplementedError("Intersection requires a geo:geometry property")
        result = {lhs.query: _scalar(rhs)}
        for binding in BINDINGS:
            if (binding.namespace, binding.local) == (GEO, "relation"):
                result[binding.query] = "intersects"
        return result

    def adopt_result(self, result: object) -> dict[str, str]:
        """Log unadvertised option values without rejecting them.

        Warnings use the generated module's standard-library logger and are
        emitted once per final parameter assignment in each evaluation.

        Raises:
            NotImplementedError: If the expression is not a CQL2 predicate.
        """
        if not isinstance(result, dict):
            raise NotImplementedError("Expected a CQL2 predicate")
        for parameter, value in result.items():
            options = PARAMETER_OPTIONS.get(parameter)
            if options and value not in options:
                logging.getLogger(__name__).warning(
                    "Parameter %s has value %r outside advertised options %r; "
                    "accepting it because options are suggestions",
                    parameter, value, options,
                )
        return result


def to_opensearch(
    root: ast.AstType, *, attribute_map: Mapping[str, str] | None = None,
) -> dict[str, str]:
    """Convert a pygeofilter AST to decoded query parameters."""
    return OpenSearchEvaluator(attribute_map).evaluate(root)


def from_cql2_text(
    expression: str, *, attribute_map: Mapping[str, str] | None = None,
) -> dict[str, str]:
    """Parse CQL2 text and return decoded OpenSearch parameters."""
    return to_opensearch(parse_text(expression), attribute_map=attribute_map)


def from_cql2_json(
    expression: str | dict, *, attribute_map: Mapping[str, str] | None = None,
) -> dict[str, str]:
    """Parse CQL2 JSON and return decoded OpenSearch parameters."""
    return to_opensearch(parse_json(expression), attribute_map=attribute_map)


def invoke(
    result: dict[str, str],
    defaults: Mapping[str, str] | None = None,
) -> dict[str, Any]:
    """Merge defaults and fixed parameters, then validate decoded values.

    Raises:
        NotImplementedError: If the result is not a parameter mapping.
        ValueError: If parameters are unknown, fixed, missing, or invalid.
    """
    defaults = dict(defaults or {})
    supplied = {**defaults, **result}
    allowed = {binding.query for binding in BINDINGS}
    for key, value in supplied.items():
        if key in FIXED and value != FIXED[key]:
            raise ValueError(f"Cannot override fixed parameter: {key}")
        if key not in allowed and key not in FIXED:
            raise ValueError(f"Unknown query parameter: {key}")
    validate_parameters(BINDINGS, supplied, DECLARATIONS, OFFSETS)

    response = requests.get(
        URL_TEMPLATE,
        params={**supplied, **FIXED},
        timeout=30,
    )
    response.raise_for_status()
    return response.json()


def invoke_from_cql2_text(
